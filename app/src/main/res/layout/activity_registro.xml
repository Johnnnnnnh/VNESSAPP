<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F6FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Nuevo Trámite"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etRegNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del Trámite"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRegStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cupos / Días estimados (Stock)"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRegPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Costo ($ Precio)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnGuardarTrámite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar en Base de Datos"
        android:padding="12dp"/>

</LinearLayout>